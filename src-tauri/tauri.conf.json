{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "com.rip.frontend",
  "productName": "rip-frontend",
  "version": "0.1.0",

  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },


  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Chronus",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

